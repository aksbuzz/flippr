PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Leave empty in development to disable auth. REQUIRED when NODE_ENV=production.
ADMIN_API_TOKEN=
# Comma-separated browser origins allowed to call this API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flippr_user
POSTGRES_PASSWORD=flippr_password
POSTGRES_DATABASE=flippr_db
POSTGRES_SSL=false

# How often the worker rebuilds the Redis flag cache from PostgreSQL (milliseconds).
CACHE_RECONCILE_INTERVAL_MS=300000
