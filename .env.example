# Copy to .env (git-ignored) before running `docker compose up --build`.

# Required. Protects the management API; the UI asks for it after the first 401.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=change-me

# Optional overrides (defaults are fine for a local machine; change them anywhere else).
# POSTGRES_USER=flippr_user
# POSTGRES_PASSWORD=flippr_password
# POSTGRES_DB=flippr_db
# REDIS_PASSWORD=flippr_redis_password

# Ports
# UI_PORT=80
# MANAGEMENT_PORT=4000

# Browser origins allowed to call the management API directly (the UI proxies /api itself).
# CORS_ORIGINS=http://localhost,http://localhost:5173
# Browser origins allowed to call the evaluation API (empty = CORS disabled).
# EVALUATION_CORS_ORIGINS=https://app.example.com
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
